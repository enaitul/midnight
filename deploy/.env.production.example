# Set these in the hosting provider's secret/environment settings. Never commit real values.
APP_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace-with-at-least-48-random-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Exact HTTPS origin of the app. This single-origin Docker setup serves the SPA and API together.
CORS_ALLOWED_ORIGINS=https://midnight.example.com
SOCKETIO_CORS_ALLOWED_ORIGINS=https://midnight.example.com

# Production media must use a private bucket. boto3 uses its standard credential chain;
# set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY as provider secrets or attach an IAM role.
MEDIA_STORAGE_BACKEND=s3
S3_BUCKET=midnight-private-media
S3_REGION=auto
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_PREFIX=midnight
AWS_ACCESS_KEY_ID=provide-as-a-secret
AWS_SECRET_ACCESS_KEY=provide-as-a-secret

# Use a shared Redis URI if running more than one application instance. The single-instance
# fallback is process-local memory and resets when the service restarts.
RATELIMIT_STORAGE_URI=memory://
PROXY_FIX_X_FOR=1
GUNICORN_THREADS=100
GUNICORN_TIMEOUT=120
LOG_LEVEL=INFO
PORT=10000

# These Vite values are build arguments for deploy/Dockerfile. Keep the API same-origin.
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
