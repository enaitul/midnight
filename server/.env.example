# Secret key for signing tokens — generate a random one and keep it private
SECRET_KEY=change-me-to-a-random-string

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/midnight_db

# Google OAuth Client ID (obtained from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Flask environment
APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=1

# Development storage and allowed browser origins
MEDIA_STORAGE_BACKEND=local
SOCKETIO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATELIMIT_STORAGE_URI=memory://

# Supabase Storage S3-compatible API (local development remains on local storage).
# Copy the endpoint and region from the Supabase Storage S3 settings page.
S3_BUCKET=your-private-bucket-name
S3_REGION=your-supabase-project-region
S3_ENDPOINT_URL=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_PREFIX=midnight
AWS_ACCESS_KEY_ID=your-supabase-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key

# Production-only values are documented in deploy/.env.production.example.
# Do not enable production until secret, database, HTTPS origins, and private S3
# storage are configured. Use a trusted proxy hop count only behind a proxy.
